{
  "name": "cosplay-compass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "npx vercel dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cloudflare:login": "npx wrangler login",
    "cloudflare:dev": "npx wrangler dev --config cloudflare/wrangler.jsonc --remote",
    "cloudflare:deploy": "npx wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "firebase": "^11.10.0",
    "image-size": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "4.149.0"
  }
}
